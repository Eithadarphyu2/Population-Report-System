UC2 --> R08
UC2 --> R09
UC2 --> R10
UC2 --> R11
UC2 --> R12
UC2 --> R13
UC2 --> R14
UC2 --> R15
UC2 --> R16

' Capital City Report group
UC3 --> R17
UC3 --> R18
UC3 --> R19
UC3 --> R20
UC3 --> R21
UC3 --> R22

' Population Distribution group
UC4 --> R23
UC4 --> R24
UC4 --> R25

' Population Total group
UC5 --> R26
UC5 --> R27
UC5 --> R28
UC5 --> R29
UC5 --> R30
UC5 --> R31

' Language Report group
UC6 --> R32

' Reports to database
R01 --> DB
R02 --> DB
R03 --> DB
R04 --> DB
R05 --> DB
R06 --> DB

R07 --> DB
R08 --> DB
R09 --> DB
R10 --> DB
R11 --> DB
