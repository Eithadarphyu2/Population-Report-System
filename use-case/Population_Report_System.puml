@startuml

left to right direction

actor User
database "Population Database" as DB

rectangle "Population Reporting System" {

    usecase "Generate Country Report" as UC1
    usecase "Generate City Report" as UC2
    usecase "Generate Capital City Report" as UC3
    usecase "Generate Population Distribution Report" as UC4
    usecase "Generate Population Total Report" as UC5
    usecase "Generate Language Population Report" as UC6

    ' Country Reports
    usecase "All Countries Worldwide" as R01
    usecase "Countries by Continent" as R02
    usecase "Countries by Region" as R03
    usecase "Top N Countries Worldwide" as R04
    usecase "Top N Countries by Continent" as R05
    usecase "Top N Countries by Region" as R06

    ' City Reports
    usecase "All Cities Worldwide" as R07
    usecase "Cities by Continent" as R08
    usecase "Cities by Region" as R09
    usecase "Cities by Country" as R10
    usecase "Cities by District" as R11
    usecase "Top N Cities Worldwide" as R12
    usecase "Top N Cities by Continent" as R13
    usecase "Top N Cities by Region" as R14
    usecase "Top N Cities by Country" as R15
    usecase "Top N Cities by District" as R16

    ' Capital City Reports
    usecase "All Capital Cities Worldwide" as R17
    usecase "Capital Cities by Continent" as R18
    usecase "Capital Cities by Region" as R19
    usecase "Top N Capital Cities Worldwide" as R20
    usecase "Top N Capital Cities by Continent" as R21
    usecase "Top N Capital Cities by Region" as R22

    ' Population Distribution Reports
    usecase "Population Distribution by Continent" as R23
    usecase "Population Distribution by Region" as R24
    usecase "Population Distribution by Country" as R25

    ' Population Total Reports
    usecase "World Population" as R26
    usecase "Continent Population" as R27
    usecase "Region Population" as R28
    usecase "Country Population" as R29
    usecase "District Population" as R30
    usecase "City Population" as R31

    ' Language Report
    usecase "Language Population Report" as R32
}

' User to main use cases
User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6

